# VoiceIran Backend Environment Variables

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
SQLITE_DB_NAME=db.sqlite3

# Admin Dashboard Frontend URL
ADMIN_FRONTEND_URL=http://localhost:3001

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# Analytics
ANALYTICS_STORE_PAGEVIEWS=False
SEARCH_INDEX_STORE_DB=False
